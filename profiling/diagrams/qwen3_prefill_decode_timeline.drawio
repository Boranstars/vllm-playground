<mxCell id="n103" value="[T] First Decode host NVTX ends at 133249.143 µs; graph 2439 runs on GPU at 134170.634–139008.495 µs. These spans differ." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=19;" vertex="1" parent="n70"><mxGeometry x="25" y="480" width="2270" height="42" as="geometry"/></mxCell>
<mxCell id="n104" value="&lt;div style=&quot;font-size:20px;line-height:1.3;font-weight:600;&quot;&gt;Host execution duration ≠ complete GPU execution duration&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.3;color:#475569;&quot;&gt;An execute_context range records the host-side scope.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#1E293B;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=7;fillColor=#F4F6F8;strokeColor=#8995A5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="740" height="90" as="geometry"/></mxCell>
<mxCell id="n105" value="&lt;div style=&quot;font-size:20px;line-height:1.3;font-weight:600;&quot;&gt;Host submission and GPU execution are asynchronous&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.3;color:#475569;&quot;&gt;A runtime event wait is not automatically a whole-graph barrier.&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=20;fontColor=#1E293B;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=7;fillColor=#F4F6F8;strokeColor=#8995A5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="1360" width="740" height="90" as="geometry"/></mxCell>
