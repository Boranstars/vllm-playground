<mxCell id="n11" value="&lt;div style=&quot;font-size:21px;line-height:1.3;font-weight:600;&quot;&gt;Decoder Block ×28&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;hidden size 1024 · Q heads 16 · KV heads 8&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;head_dim 128 · intermediate size 3072&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;打包 QKV 宽度 = 2048 + 1024 + 1024&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=20;" vertex="1" parent="n5"><mxGeometry x="25" y="65" width="610" height="135" as="geometry"/></mxCell>
<mxCell id="n12" value="&lt;div style=&quot;font-size:21px;line-height:1.3;font-weight:600;&quot;&gt;本实验含 30 个 context token&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;token 并行 workload；线性操作主要使用 GEMM&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;分段式（piecewise）CUDA Graph&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;Attention / KV Cache 路径位于 Graph 区域之外&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=20;" vertex="1" parent="n7"><mxGeometry x="25" y="65" width="750" height="155" as="geometry"/></mxCell>
<mxCell id="n13" value="&lt;div style=&quot;font-size:21px;line-height:1.3;font-weight:600;&quot;&gt;每个生成 step 处理一个新 token · 自回归&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;按 token 重复执行&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;线性操作常使用 GEMV / 小型 GEMM&lt;/div&gt;&lt;div style=&quot;font-size:19px;line-height:1.3;color:#475569;&quot;&gt;模型执行通过更大的 CUDA Graph 回放&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=20;" vertex="1" parent="n9"><mxGeometry x="25" y="65" width="750" height="155" as="geometry"/></mxCell>
