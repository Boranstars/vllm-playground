<mxCell id="n102" value="代表性 Transformer 模式 ×28  [S] · 回放 n 中执行 337 次 kernel  [T]" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=18;" vertex="1" parent="n70"><mxGeometry x="660" y="445" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="n103" value="[T] 首个 Decode 的 Host NVTX 于 133249.143 µs 结束；Graph 2439 在 GPU 上于 134170.634–139008.495 µs 执行。两者时间区间不同。" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontSize=19;" vertex="1" parent="n70"><mxGeometry x="25" y="480" width="2270" height="42" as="geometry"/></mxCell>
<mxCell id="n104" value="&lt;div style=&quot;font-size:20px;line-height:1.3;font-weight:600;&quot;&gt;Host 执行时长 ≠ GPU 完整执行时长&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.3;color:#475569;&quot;&gt;execute_context range 记录 Host 侧的范围。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=7;fillColor=#F4F6F8;strokeColor=#8995A5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="740" height="90" as="geometry"/></mxCell>
<mxCell id="n105" value="&lt;div style=&quot;font-size:20px;line-height:1.3;font-weight:600;&quot;&gt;Host 提交与 GPU 执行是异步的&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.3;color:#475569;&quot;&gt;runtime event 等待不一定是整个 Graph 的同步屏障。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=7;fillColor=#F4F6F8;strokeColor=#8995A5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="1360" width="740" height="90" as="geometry"/></mxCell>
<mxCell id="n106" value="&lt;div style=&quot;font-size:20px;line-height:1.3;font-weight:600;&quot;&gt;sem_wait 是 CPU 侧的 runtime 协调等待&lt;/div&gt;&lt;div style=&quot;font-size:18px;line-height:1.3;color:#475569;&quot;&gt;它不是 GPU 计算。[T] 本请求的 OSRT 中有记录。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#1E293B;rounded=1;arcSize=10;align=center;verticalAlign=middle;spacing=7;fillColor=#F4F6F8;strokeColor=#8995A5;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1600" y="1360" width="760" height="90" as="geometry"/></mxCell>
