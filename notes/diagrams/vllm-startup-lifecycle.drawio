<mxCell id="4" value="依据实际日志顺序归纳为六个阶段 · 本次启动恢复已有 AOT 编译产物" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontColor=#243448;fontSize=16;fontColor=#657487;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1800" height="30" as="geometry"/></mxCell>
<mxCell id="5" value="&lt;div style=&quot;font-size:15px;color:#536e8c;&quot;&gt;&lt;b&gt;01&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.2;margin-top:10px;&quot;&gt;&lt;b&gt;解析配置 /&lt;br&gt;构建引擎&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:20px;&quot;&gt;确定模型架构&lt;br&gt;运行时 / 显存配置&lt;br&gt;选择 Worker /&lt;br&gt;V2 ModelRunner&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#536e8c;margin-top:22px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:6px;&quot;&gt;已解析的引擎配置&lt;br&gt;+ 执行骨架&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="280" height="350" as="geometry"/></mxCell>
<mxCell id="6" value="&lt;div style=&quot;font-size:15px;color:#536e8c;&quot;&gt;&lt;b&gt;02&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.2;margin-top:10px;&quot;&gt;&lt;b&gt;加载模型与&lt;br&gt;执行产物&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:20px;&quot;&gt;加载模型权重&lt;br&gt;恢复已有 AOT /&lt;br&gt;编译产物&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#536e8c;margin-top:22px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:6px;&quot;&gt;模型 + 权重&lt;br&gt;+ 可复用的执行产物&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="200" width="280" height="350" as="geometry"/></mxCell>
<mxCell id="7" value="&lt;div style=&quot;font-size:15px;color:#536e8c;&quot;&gt;&lt;b&gt;03&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.2;margin-top:10px;&quot;&gt;&lt;b&gt;探测资源占用 /&lt;br&gt;准备执行环境&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:20px;&quot;&gt;初次资源探测 / 预热&lt;br&gt;第一轮 CUDA Graph 捕获&lt;br&gt;&lt;b&gt;运行时本身也需要&lt;br&gt;显存和执行状态。&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#536e8c;margin-top:22px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:6px;&quot;&gt;执行资源占用&lt;br&gt;+ 运行时状态&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="200" width="280" height="350" as="geometry"/></mxCell>
<mxCell id="8" value="&lt;div style=&quot;font-size:15px;color:#536e8c;&quot;&gt;&lt;b&gt;04&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.2;margin-top:10px;&quot;&gt;&lt;b&gt;确定 KV 容量 /&lt;br&gt;创建 KV 缓存&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:20px;&quot;&gt;确定 KV 可用显存&lt;br&gt;确定 KV token 容量&lt;br&gt;创建 KV cache*&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#536e8c;margin-top:22px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:6px;&quot;&gt;固定容量的 KV 池&lt;br&gt;+ 请求状态容量&lt;/div&gt;&lt;div style=&quot;font-size:14px;color:#738091;margin-top:12px;&quot;&gt;本次基线：36,976 KV tokens&lt;br&gt;/ 3.95 GiB&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="200" width="280" height="350" as="geometry"/></mxCell>
<mxCell id="9" value="&lt;div style=&quot;font-size:15px;color:#536e8c;&quot;&gt;&lt;b&gt;05&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:1.2;margin-top:10px;&quot;&gt;&lt;b&gt;完成热点&lt;br&gt;执行路径准备&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:1.4;margin-top:20px;&quot;&gt;JIT 内核预热&lt;br&gt;第二轮 CUDA Graph 捕获&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#536e8c;margin-top:22px;&quot;&gt;&lt;b&gt;输出&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;line-height:1.35;margin-top:6px;&quot;&gt;已预热 / 准备就绪的&lt;br&gt;稳态执行路径&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=20;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="280" height="350" as="geometry"/></mxCell>
