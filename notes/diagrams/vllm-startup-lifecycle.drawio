<mxCell id="28" value="&lt;b&gt;启动不只是加载模型；它在开始服务前，&lt;br&gt;建立模型状态、执行状态、资源容量，以及预热就绪的热点执行路径。&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontColor=#243448;fontSize=22;fontColor=#243448;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1830" height="60" as="geometry"/></mxCell>
