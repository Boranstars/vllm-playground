        <mxCell id="27" value="随后" source="24" target="25" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9673A6;endArrow=block;endFill=1;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-25" as="offset" />
          </mxGeometry>
