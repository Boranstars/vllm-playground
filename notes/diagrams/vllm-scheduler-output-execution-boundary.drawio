        <mxCell id="28" value="然后" source="25" target="26" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#6C8EBF;endArrow=block;endFill=1;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#6C8EBF;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
