  <diagram id="cp6-boundary" name="CP6 · 调度与执行的接口边界">
    <mxGraphModel dx="2320" dy="1630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1630" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="CP6 · Scheduler → SchedulerOutput → Execution side" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=38;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="2200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="跨层接口图  |  调度器如何把本轮决策交付给执行侧" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="2200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:30px;font-weight:bold&quot;&gt;SchedulerOutput 是本轮 execution plan + state synchronization message。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#F5F5F5;strokeColor=#94A3B8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="2200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Scheduler · 内部调度状态" style="swimlane;html=1;whiteSpace=wrap;startSize=65;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F2F7FD;swimlaneFillColor=#F2F7FD;strokeColor=#6C8EBF;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=28;fontStyle=1;fontColor=#334155;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="520" height="750" as="geometry" />
        </mxCell>
        <mxCell id="6" value="本轮计划与状态同步" style="swimlane;html=1;whiteSpace=wrap;startSize=65;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F5F0F8;swimlaneFillColor=#F5F0F8;strokeColor=#9673A6;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=28;fontStyle=1;fontColor=#334155;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="720" height="750" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Execution side · 执行侧" style="swimlane;html=1;whiteSpace=wrap;startSize=65;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F2F8F0;swimlaneFillColor=#F2F8F0;strokeColor=#82B366;strokeWidth=2;fontFamily=Noto Sans CJK SC;fontSize=28;fontStyle=1;fontColor=#334155;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="1740" y="330" width="520" height="750" as="geometry" />
        </mxCell>
        <mxCell id="8" value="接口对象：SchedulerOutput" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#64748B;fontStyle=0;" vertex="1" parent="6">
          <mxGeometry x="30" y="75" width="660" height="45" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;维护请求与队列&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;哪些请求等待，哪些请求处于运行集合&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;waiting / running&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="5">
          <mxGeometry x="30" y="100" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;维护容量与预算&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;检查 KV 容量，分配本轮 token 额度&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;KV state / token_budget / input_budget&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="5">
          <mxGeometry x="30" y="275" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;决定谁推进、谁等待&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;接纳新请求；必要时选择 victim 抢占&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;admission / preemption&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="5">
          <mxGeometry x="30" y="460" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="12" value="队列、剩余预算与决策过程留在调度器内部。&lt;br/&gt;对外传递所需结果，不暴露内部决策细节。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#1E3A5F;fontStyle=1;" vertex="1" parent="5">
          <mxGeometry x="30" y="635" width="460" height="85" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;① Request state · 请求状态&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;新请求：完整初始化信息&lt;br/&gt;已有请求：本轮增量更新&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;NewRequestData / CachedRequestData&lt;br/&gt;token IDs · 参数 · block IDs · 计算起点&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.8;" vertex="1" parent="6">
          <mxGeometry x="30" y="130" width="660" height="210" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;② This-step work plan · 本轮工作量&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;每个 request 本轮执行多少 token&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;num_scheduled_tokens：request ID → 本轮 token 数&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.8;" vertex="1" parent="6">
          <mxGeometry x="30" y="375" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;③ State synchronization · 状态同步&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;结束 / 抢占通知&lt;br/&gt;必要的 block 与请求状态更新&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;finished_req_ids / preempted_req_ids&lt;br/&gt;block/state updates 也由请求数据携带&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.8;" vertex="1" parent="6">
          <mxGeometry x="30" y="550" width="660" height="170" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;接收并应用接口信息&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;建立 / 更新请求执行状态&lt;br/&gt;处理必要的状态同步&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.8;" vertex="1" parent="7">
          <mxGeometry x="30" y="100" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;按本轮计划执行工作&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;结合已有执行状态，&lt;br/&gt;推进计划指定的 token&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.8;" vertex="1" parent="7">
          <mxGeometry x="30" y="285" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;无需知道决策过程&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;不依赖 Scheduler 内部&lt;br/&gt;如何选择请求或 victim&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.8;" vertex="1" parent="7">
          <mxGeometry x="30" y="470" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="19" value="具体调用链留给 CP7&lt;br/&gt;Executor / Worker / ModelRunner" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#64748B;fontStyle=1;" vertex="1" parent="7">
          <mxGeometry x="30" y="640" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="20" value="封装决策结果" source="5" target="6" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#6C8EBF;endArrow=block;endFill=1;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#6C8EBF;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-25" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="跨层交付" source="6" target="7" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9673A6;endArrow=block;endFill=1;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-25" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="22" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:31px;font-weight:bold&quot;&gt;调度状态 ≠ 执行计划 ≠ 实际执行完成状态&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;账面进度推进、接口交付和 GPU 工作完成，是不同的时刻。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1140" width="2200" height="105" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Scheduler.schedule() 尾部的小时间线" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#334155;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1280" width="2200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;构造本轮计划 snapshot&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;保留本轮输入起点&lt;br/&gt;封装工作量与同步信息&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;SchedulerOutput(...)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1350" width="600" height="170" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;推进内部账面进度，准备下一轮&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;增加计算进度与 in-flight 计数&lt;br/&gt;更新 prefill 跟踪，换用新的通知集合&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;_update_after_schedule()&lt;br/&gt;num_computed_tokens / num_in_flight_tokens&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="870" y="1350" width="740" height="170" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:27px;font-weight:bold&quot;&gt;返回本轮接口对象&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px&quot;&gt;将已构造的计划交付出去&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#64748B&quot;&gt;return scheduler_output&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;spacing=15;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1350" width="440" height="170" as="geometry" />
