<mxfile host="drawio" version="30.3.14">
  <diagram id="cp5-preemption" name="CP5 · Current 与 Victim">
    <mxGraphModel dx="1800" dy="2300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2300" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="CP5 · KV 分配失败后的抢占控制流" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=36;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1600" height="65" as="geometry" />
        </mxCell>
        <mxCell id="3" value="RUNNING request  |  两个角色：谁需要更多 KV，谁让出已有 KV" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="100" y="105" width="1600" height="45" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:28px;font-weight:bold&quot;&gt;KV allocation 失败的请求，不一定就是被 preempt 的请求。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#F5F5F5;strokeColor=#94A3B8;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="100" y="170" width="1600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;Current request · 当前申请者&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;正在尝试申请更多 KV 的 RUNNING 请求&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;request&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="100" y="280" width="750" height="100" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;Victim · 被选中的牺牲者&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Scheduler 选择用于释放 KV 的 RUNNING 请求&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;preempted_req&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="950" y="280" width="750" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;当前 RUNNING 请求&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;计划推进本轮工作&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="600" y="430" width="600" height="90" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;尝试取得本轮所需的 KV 空间&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;申请者始终是 Current request&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;allocate_slots(request, num_new_tokens, ...)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="600" y="580" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;Current 继续本轮&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;登记计划，等待后续模型执行&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;scheduled_running_reqs / num_scheduled_tokens&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1350" y="580" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;KV 容量验证失败&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;进入 victim 选择路径&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;new_blocks is None&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="600" y="770" width="600" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;选择 Victim&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;FCFS：查看 RUNNING 列表队尾&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;preempted_req = self.running[-1]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="600" y="930" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;从 RUNNING 列表移除 Victim&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;随后调用抢占函数处理这个 Victim&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;self.running.pop() → _preempt_request(victim)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="600" y="1100" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="对 Victim 执行抢占 · 状态变化与重新入队" style="swimlane;html=1;whiteSpace=wrap;startSize=60;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#FFF7ED;swimlaneFillColor=#FFF7ED;strokeColor=#D79B00;strokeWidth=1.8;fontFamily=Noto Sans CJK SC;fontSize=26;fontStyle=1;fontColor=#92400E;align=left;spacingLeft=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="1300" width="1600" height="290" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;释放 Victim 的 KV&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;调用 KV 释放接口&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;_free_request_blocks(victim)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="13">
          <mxGeometry x="50" y="100" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;Victim 状态改变&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;RUNNING → PREEMPTED&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;request.status = PREEMPTED&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="13">
          <mxGeometry x="430" y="100" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;计算进度归零&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;保留 prompt 与已生成 token&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;num_computed_tokens = 0&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="13">
          <mxGeometry x="810" y="100" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;放回等待队首&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;状态仍为 PREEMPTED&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;self.waiting.prepend_request(victim)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.8;" vertex="1" parent="13">
          <mxGeometry x="1190" y="100" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:24px;font-weight:bold&quot;&gt;Victim 是当前申请者吗？&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;preempted_req == request&lt;/span&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.8;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="650" y="1720" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;Victim ≠ Current：继续重试&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;让出 KV 后，为 Current 再次尝试 allocation&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;回到 while True；成功则 Current 进入本轮计划&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="120" y="2040" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;div style=&quot;text-align:center;line-height:1.2&quot;&gt;&lt;span style=&quot;font-size:26px;font-weight:bold&quot;&gt;Victim = Current：本轮停止推进&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:20px&quot;&gt;当前申请者自己被抢占，已放回等待队列&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;退出分配小循环 → new_blocks is None → 退出 RUNNING 扫描&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=12;fontFamily=Noto Sans CJK SC;fontColor=#1E293B;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.8;" vertex="1" parent="1">
          <mxGeometry x="1060" y="2040" width="640" height="140" as="geometry" />
        </mxCell>
