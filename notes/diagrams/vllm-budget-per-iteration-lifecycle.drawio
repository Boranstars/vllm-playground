        <mxCell id="12" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;WAITING C&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;使用剩余的 512 tokens&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;color:#14532D;&quot;&gt;KV 容量验证通过&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:21px;color:#14532D;font-weight:bold;&quot;&gt;commit 后扣减 512&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：&lt;br/&gt;num_scheduled_tokens[C] = 512&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.6;" vertex="1" parent="5">
