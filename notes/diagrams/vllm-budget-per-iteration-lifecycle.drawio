          <mxGeometry x="1390" y="290" width="450" height="530" as="geometry" />
        </mxCell>
        <mxCell id="7" value="先扫描 RUNNING 请求，再让 WAITING 使用剩余预算。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#334155;fontStyle=1;" vertex="1" parent="5">
          <mxGeometry x="30" y="55" width="1160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="8" value="进入新一轮，重新读取预算配置。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#334155;fontStyle=1;" vertex="1" parent="6">
          <mxGeometry x="30" y="55" width="390" height="35" as="geometry" />
