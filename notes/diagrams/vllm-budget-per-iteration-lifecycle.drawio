        <mxCell id="9" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;轮次开始&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;重新领取本轮额度&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;font-weight:bold;&quot;&gt;两份预算都从 2048 起步&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#64748B;&quot;&gt;源码辅助：&lt;br/&gt;token_budget = max_num_scheduled_tokens&lt;br/&gt;input_budget = max_num_batched_tokens&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.6;" vertex="1" parent="5">
          <mxGeometry x="30" y="100" width="240" height="205" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;RUNNING A&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;本轮计划推进 512 tokens&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;color:#14532D;&quot;&gt;KV 容量验证通过&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:21px;color:#14532D;font-weight:bold;&quot;&gt;commit 后扣减 512&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：&lt;br/&gt;num_scheduled_tokens[A] = 512&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.6;" vertex="1" parent="5">
          <mxGeometry x="330" y="100" width="240" height="205" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;RUNNING B&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;本轮计划推进 1024 tokens&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;color:#14532D;&quot;&gt;KV 容量验证通过&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:21px;color:#14532D;font-weight:bold;&quot;&gt;commit 后扣减 1024&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：&lt;br/&gt;num_scheduled_tokens[B] = 1024&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.6;" vertex="1" parent="5">
          <mxGeometry x="630" y="100" width="240" height="205" as="geometry" />
