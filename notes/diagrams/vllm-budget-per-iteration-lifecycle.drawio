        <mxCell id="28" value="下一轮：重新初始化" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#1E3A5F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="595" width="220" height="35" as="geometry" />
        </mxCell>
        <mxCell id="29" value="只有容量验证成功并 commit，才为这个请求扣减预算；尝试本身不扣减。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#64748B;fontStyle=0;" vertex="1" parent="5">
          <mxGeometry x="30" y="475" width="1180" height="35" as="geometry" />
        </mxCell>
