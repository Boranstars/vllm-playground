          <mxGeometry x="30" y="475" width="390" height="35" as="geometry" />
        </mxCell>
        <mxCell id="31" value="跨轮延续的轨道 · request progress / KV state" style="swimlane;html=1;whiteSpace=wrap;startSize=45;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F8F4FA;swimlaneFillColor=#F8F4FA;strokeColor=#C6B6CF;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#334155;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1780" height="260" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:21px;font-weight:bold;&quot;&gt;Iteration N 结束后的请求状态&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;A：原进度 +512；B：原进度 +1024；C：原进度 +512&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;未结束请求保留已有的 KV blocks。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：num_computed_tokens += num_scheduled_token&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.6;" vertex="1" parent="31">
          <mxGeometry x="30" y="65" width="610" height="130" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:21px;font-weight:bold;&quot;&gt;Iteration N+1 从延续状态出发&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;沿用请求进度与已有 KV 状态，继续安排未完成的工作。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;每轮重新建立的是 budget；请求状态跨轮保留。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=10;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#1E293B;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.6;" vertex="1" parent="31">
          <mxGeometry x="1110" y="65" width="610" height="130" as="geometry" />
        </mxCell>
        <mxCell id="34" value="未结束请求的状态延续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673A6;endArrow=block;endFill=1;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="32" target="33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="num_computed_tokens 是调度账面进度，可含在途工作；本图示例不涉及结束、抢占或 KV 释放。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#64748B;fontStyle=0;" vertex="1" parent="31">
          <mxGeometry x="30" y="215" width="1720" height="35" as="geometry" />
        </mxCell>
        <mxCell id="36" value="同数值，不同职责 · token_budget" style="swimlane;html=1;whiteSpace=wrap;startSize=45;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F2F7FD;swimlaneFillColor=#F2F7FD;strokeColor=#A7BDDA;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#334155;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1230" width="840" height="240" as="geometry" />
        </mxCell>
        <mxCell id="37" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:21px;font-weight:bold;&quot;&gt;限制本轮调度器还能签发多少 token 工作。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;&quot;&gt;每次 commit，消耗计划推进的 token 数。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;&quot;&gt;示例：剩余 2048，commit 512 → 剩余 1536。&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B;&quot;&gt;源码辅助：token_budget -= num_new_tokens&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#334155;fontStyle=0;" vertex="1" parent="36">
          <mxGeometry x="25" y="65" width="790" height="145" as="geometry" />
        </mxCell>
        <mxCell id="38" value="同数值，不同职责 · input_budget" style="swimlane;html=1;whiteSpace=wrap;startSize=45;rounded=1;arcSize=7;container=1;collapsible=0;pointerEvents=0;fillColor=#F2F7FD;swimlaneFillColor=#F2F7FD;strokeColor=#A7BDDA;strokeWidth=1.5;fontFamily=Noto Sans CJK SC;fontSize=22;fontStyle=1;fontColor=#334155;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="950" y="1230" width="890" height="240" as="geometry" />
        </mxCell>
        <mxCell id="39" value="&lt;div style=&quot;text-align:center;line-height:1.1&quot;&gt;&lt;span style=&quot;font-size:21px;font-weight:bold;&quot;&gt;限制本轮模型输入批次的 token 容量。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;&quot;&gt;还需为额外 drafting slots 留出空间；baseline 无此项。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;&quot;&gt;draft_slots=0 时，同样消耗 512：2048 → 1536。&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B;&quot;&gt;源码辅助：input_budget -= num_new_tokens + draft_slots&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#334155;fontStyle=0;" vertex="1" parent="38">
          <mxGeometry x="25" y="65" width="840" height="145" as="geometry" />
