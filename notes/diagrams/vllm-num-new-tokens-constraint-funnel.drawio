        <mxCell id="21" value="剩余额度 2048 → 候选工作量 2048" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#1E3A5F;fontStyle=1;" vertex="1" parent="16">
