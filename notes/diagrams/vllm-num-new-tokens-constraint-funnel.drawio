        <mxCell id="11" value="预算 / 长度规则允许的数量&lt;br/&gt;仍需 KV 验证才能提交" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
