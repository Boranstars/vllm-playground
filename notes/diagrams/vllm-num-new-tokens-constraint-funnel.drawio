        </mxCell>
        <mxCell id="27" value="额度足够时，也只安排剩余需求的 3000。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#475569;fontStyle=0;" vertex="1" parent="16">
          <mxGeometry x="20" y="335" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="28" value="数值示例：两份剩余预算均为 2048；没有草稿额度占用；长度安全与其他约束均不额外收紧。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="965" width="1450" height="35" as="geometry" />
        </mxCell>
        <mxCell id="29" value="" style="rounded=0;html=1;fillColor=#334155;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="1460" height="6" as="geometry" />
        </mxCell>
        <mxCell id="30" value="03 · 状态容量校验 · KV capacity validation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#9A5B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="1450" height="45" as="geometry" />
        </mxCell>
        <mxCell id="31" value="这里不继续裁剪候选量：验证 KV 状态容量是否允许提交这份计划（commit）。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1100" width="1450" height="35" as="geometry" />
        </mxCell>
        <mxCell id="32" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;KV 状态空间够不够承载候选工作？&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;验证推进这些 token 所需的 KV 槽位能否获得。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;font-weight:bold;&quot;&gt;例：候选仍是 2048；容量足够才允许 commit。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：allocate_slots(request, num_new_tokens)&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.6;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="330" y="1170" width="540" height="95" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;div style=&quot;text-align:left;line-height:1.05&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;容量验证成功 → commit 本轮计划&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;登记这个请求的候选工作量，同时占用本轮共享预算。&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:22px;font-weight:bold;&quot;&gt;例：登记 2048；两份剩余预算从 2048 → 0。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;这是计划与预算记账，不代表模型已经执行完成。&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;源码辅助：num_scheduled_tokens[request_id] = num_new_tokens&lt;br/&gt;token_budget -= num_new_tokens&lt;br/&gt;input_budget -= num_new_tokens + draft_slots&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.6;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="90" y="1380" width="900" height="220" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;b&gt;容量验证失败&lt;/b&gt;&lt;br/&gt;&lt;b&gt;CP5 · Preemption&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;尚未 commit；后续资源处理不展开。&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=12;rounded=1;arcSize=12;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.6;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1280" width="380" height="115" as="geometry" />
        </mxCell>
        <mxCell id="35" value="候选量仍是 2048；如何处理失败留到 CP5。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1415" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="36" value="容量足够 · 可以 commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D8756;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#4D8756;labelBackgroundColor=#FFFFFF;exitX=0.35;exitY=1;entryX=0.55;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="32" target="33">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-95" y="0" as="offset" />
          </mxGeometry>
