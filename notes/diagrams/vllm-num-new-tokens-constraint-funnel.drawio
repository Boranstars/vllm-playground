        <mxCell id="12" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;候选本轮工作量&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px;&quot;&gt;candidate per-iteration work&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:29px;font-weight:bold;&quot;&gt;例：2048 tokens&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：final num_new_tokens；尚未 commit&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.6;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="350" y="850" width="400" height="100" as="geometry" />
