  <diagram id="num-new-tokens-funnel" name="Checkpoint 3 · num_new_tokens 约束漏斗">
    <mxGraphModel dx="1580" dy="1740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1740" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="num_new_tokens · 约束漏斗" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="remaining work → fairness cap → iteration budget → length safety → optional constraints → candidate work" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=19;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1460" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="01 · 需求量 → 逐项裁剪" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#1E3A5F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="155" width="960" height="35" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;尚待推进的需求量 · remaining work&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;请求仍有输入位置需要计算；先记需求，还没有承诺本轮执行。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;计量对象：请求 token 范围与调度账面进度之间的差额。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;例：还有 3000 个位置待计算 → 需求量 3000&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B;&quot;&gt;源码辅助：num_tokens_with_spec + num_output_placeholders − num_computed_tokens&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;rounded=1;arcSize=12;fillColor=#EDF4FC;strokeColor=#A7BDDA;strokeWidth=1.6;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="960" height="130" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;公平性上限 · long-prefill fairness cap&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;多请求竞争时，避免长 prompt 独占本轮工作额度。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;限制单请求份额：启用 cap 后，超出的需求被截短。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;例：threshold=0 时 3000→3000；若 cap=1024 则→1024&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：0 &amp;lt; threshold &amp;lt; n 时，n = threshold&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=80.0;flipV=1;fillColor=#E5EFFB;strokeColor=#88A9D0;strokeWidth=1.6;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="70.0" y="360" width="960" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;每轮工作额度 · per-iteration budget&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;每轮可处理的 token / 输入规模有限，多个请求共享额度。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;候选量不能超过剩余调度预算与可用输入预算。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;例：需求 3000，剩余额度 2048 → 本轮候选 2048&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：n = min(n, token_budget, input_budget − draft_slots)&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=80.0;flipV=1;fillColor=#B7D0EF;strokeColor=#6C8EBF;strokeWidth=1.6;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="150.0" y="480" width="800" height="120" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;序列长度安全 · model-length safety&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;防止推进后的序列越界，并为本步采样留出长度余量。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:16px;&quot;&gt;限制的是可用序列长度；余量更小时，候选量继续减少。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;例：长度余量充足，2048 → 2048&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#64748B;&quot;&gt;源码辅助：n = min(n, max_model_len − num_computed_tokens − num_sampled_tokens_per_step)&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=80.0;flipV=1;fillColor=#86AAD7;strokeColor=#587EAF;strokeWidth=1.6;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="230.0" y="610" width="640" height="120" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;line-height:1.0&quot;&gt;&lt;span style=&quot;font-size:17px;font-weight:bold;&quot;&gt;可选约束 · optional constraints&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:15px;&quot;&gt;特殊模型还可能限制对齐或额外计算资源。&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:19px;font-weight:bold;&quot;&gt;本例未启用：2048 → 2048&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#64748B;&quot;&gt;源码辅助：额外裁剪点见灰色侧注。&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;fontSize=19;align=center;verticalAlign=middle;spacing=4;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=1;size=40.0;flipV=1;fillColor=#DCE8F6;strokeColor=#88A9D0;strokeWidth=1.6;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="310.0" y="740" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="02 · 本轮允许的候选量" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="850" width="270" height="35" as="geometry" />
