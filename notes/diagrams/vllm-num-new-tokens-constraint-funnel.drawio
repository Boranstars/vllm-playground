        <mxCell id="16" value="同一需求下，本轮额度改变会怎样？" style="swimlane;html=1;whiteSpace=wrap;startSize=45;container=1;collapsible=0;pointerEvents=0;rounded=1;arcSize=8;fillColor=#F4F8FD;swimlaneFillColor=#F4F8FD;strokeColor=#A7BDDA;strokeWidth=1.4;fontFamily=Noto Sans CJK SC;fontSize=18;fontStyle=1;fontColor=#334155;align=left;spacingLeft=18;" vertex="1" parent="1">
