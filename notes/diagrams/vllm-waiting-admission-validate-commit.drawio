        <mxCell id="45" value="&lt;div style=&quot;text-align:center;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;不加入 running&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px&quot;&gt;本轮不接纳这个请求&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;不执行 self.running.append(request)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#9A3412;fillColor=#FFF0E5;strokeColor=#D79B00;strokeWidth=1.6;" vertex="1" parent="24">
