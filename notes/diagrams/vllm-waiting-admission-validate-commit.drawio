        <mxCell id="7" value="WAITING / validation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#64748B;fontStyle=0;" vertex="1" parent="5">
