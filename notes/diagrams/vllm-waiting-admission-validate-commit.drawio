        <mxCell id="4" value="&lt;div style=&quot;text-align:center;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:25px;font-weight:bold&quot;&gt;Admission 不是单纯 status = RUNNING，而是资源验证成功后的一次 commit。&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#94A3B8;strokeWidth=1.6;fontFamily=Noto Sans CJK SC;fontColor=#0F172A;" vertex="1" parent="1">
