        <mxCell id="51" value="&lt;div style=&quot;text-align:center;line-height:1.15&quot;&gt;&lt;span style=&quot;font-size:22px;font-weight:bold&quot;&gt;停止本轮等待队列扫描&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px&quot;&gt;结束当前 WAITING admission 循环&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:14px;color:#64748B&quot;&gt;break&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;spacing=8;fontFamily=Noto Sans CJK SC;fontSize=18;fontColor=#9A3412;fillColor=#FFF0E5;strokeColor=#D79B00;strokeWidth=1.6;" vertex="1" parent="24">
