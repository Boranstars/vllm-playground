        <mxCell id="plan" value="&lt;div style=&quot;font-size:24px;line-height:1.3;&quot;&gt;&lt;b&gt;本轮执行计划&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.4;margin-top:12px;&quot;&gt;控制面 → 执行侧&lt;br&gt;请求、token 配额及 KV 信息&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#718091;margin-top:10px;&quot;&gt;SchedulerOutput&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;" vertex="1" parent="1">
