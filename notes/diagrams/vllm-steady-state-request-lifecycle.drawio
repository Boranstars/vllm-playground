        <mxCell id="runtime" value="&lt;div style=&quot;font-size:24px;line-height:1.3;&quot;&gt;&lt;b&gt;执行运行时&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.4;margin-top:12px;&quot;&gt;使用已准备的执行路径&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#718091;margin-top:10px;&quot;&gt;execution runtime&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#243448;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.6;" vertex="1" parent="1">
