        <mxCell id="schedule" value="&lt;div style=&quot;font-size:24px;line-height:1.3;&quot;&gt;&lt;b&gt;决定本轮推进工作&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:1.4;margin-top:12px;&quot;&gt;选哪些请求？&lt;br&gt;各推进多少 token？&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#718091;margin-top:10px;&quot;&gt;schedule&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#243448;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;" vertex="1" parent="1">
